{
  "name": "utm-student-portal",
  "version": "2.0.0",
  "private": true,
  "description": "Every University of Toronto Mississauga (UTM) link, tool and resource in one fast, searchable, installable page.",
  "type": "module",
  "homepage": "https://utmstudentportal.netlify.app/",
  "repository": "github:AbdulDevHub/UTM-Student-Portal",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check && node --test scripts/tests/*.test.mjs",
    "test": "node --test scripts/tests/*.test.mjs",
    "links": "node scripts/check-links.mjs",
    "serve": "node scripts/serve.mjs"
  },
  "engines": { "node": ">=20" }
}
